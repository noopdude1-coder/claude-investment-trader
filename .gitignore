.env
.env.*
!env.template

# Local-only notification fallback files (root-only — leading slash matters: without
# it, Windows case-insensitive matching ate routines/daily-summary.md silently)
/NOTIFICATIONS.md
/DAILY-SUMMARY.md

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor junk
.vscode/
.idea/
*.swp

# Personal bookmark export (one-off, import to Chrome and delete)
/bookmarks.html

# User-specific Claude Code state — must not be shared
.claude/settings.local.json

# Don't redistribute Nate Herk's original Opus 4.7 Trading Bot setup guide
Opus 4.7  Trading Bot — Setup Guide.docx.pdf
